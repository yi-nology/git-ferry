{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitFerry config.yaml",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "api_key": { "type": "string" },
        "api_key_role": { "type": "string", "enum": ["admin", "operator", "readonly"] }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "backup_dir": { "type": "string" },
        "backup_keep": { "type": "integer", "minimum": 0 },
        "backup_format": { "type": "string", "enum": ["bundle", "zip"] },
        "backup_encrypt_key": { "type": "string" },
        "backup_retention_days": { "type": "integer", "minimum": 0 },
        "legal_hold": { "type": "boolean" },
        "partial_clone": { "type": "string", "enum": ["", "blob:none", "tree:0"] },
        "max_concurrent": { "type": "integer", "minimum": 1 },
        "default_timeout": { "type": "integer", "minimum": 1 },
        "retry_count": { "type": "integer", "minimum": 0 },
        "post_exec_script": { "type": "string" },
        "backup_destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["s3", "webdav", "azure", "local"] },
              "name": { "type": "string" },
              "enabled": { "type": "boolean" }
            },
            "required": ["type"]
          }
        }
      }
    },
    "git_serve": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "base_path": { "type": "string" },
        "public_read": { "type": "boolean" }
      }
    },
    "runwatch": {
      "type": "object",
      "properties": {
        "interval_seconds": { "type": "integer", "minimum": 1 },
        "history_limit": { "type": "integer", "minimum": 1 },
        "retry": {
          "type": "object",
          "properties": {
            "max_auto_retries": { "type": "integer", "minimum": 0 },
            "cooldown_minutes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "oidc": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secret": { "type": "string" },
            "issuer": { "type": "string" },
            "audience": { "type": "string" }
          }
        }
      }
    }
  }
}
